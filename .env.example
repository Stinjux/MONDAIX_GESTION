# Copier ce fichier en « .env » sur le serveur et le compléter.
# Ne jamais committer le fichier .env (il est ignoré par git).

# --- Application hébergée -------------------------------------------------
HOST=0.0.0.0
PORT=3000
MONDAIX_UTILISATEUR=admin
# Obligatoire dès que l'application est accessible depuis Internet.
MONDAIX_MOT_DE_PASSE=
# Chemin de la base : doit être sur un disque persistant.
MONDAIX_DB=data/mondaix.sqlite

# --- Synchronisation email (IMAP, lecture seule) ---------------------------
EMAIL_DATE_DEPART=2026-08-01
# Intervalle en minutes (0 = désactivée ; « npm run synchro » reste utilisable).
EMAIL_SYNCHRO_MINUTES=10

# Gmail → commandes fournisseurs
# Mot de passe d'application : https://myaccount.google.com/apppasswords
# (nécessite la validation en deux étapes). Ce n'est PAS le mot de passe du compte.
GMAIL_UTILISATEUR=
GMAIL_MOT_DE_PASSE=
# Valeurs par défaut :
# GMAIL_IMAP_HOTE=imap.gmail.com
# GMAIL_IMAP_PORT=993
# GMAIL_DOSSIER=\All            (« Tous les messages », emails archivés compris)
# GMAIL_MOTS_CLES_OBJET=order,shopping
# GMAIL_EXPEDITEURS=            (vide = tous les expéditeurs)

# Neo → dossiers d'autorisation Amazon
NEO_UTILISATEUR=
NEO_MOT_DE_PASSE=
# Serveur IMAP indiqué dans les réglages Neo (à vérifier).
NEO_IMAP_HOTE=imap0001.neo.space
# NEO_IMAP_PORT=993
# NEO_DOSSIER=INBOX
# NEO_MOTS_CLES_OBJET=brand approval
# NEO_EXPEDITEURS=amazon.com,amazon.ca

# --- Factures déposées (PDF / photo) : extraction automatique -------------
# Clé de l'API Claude (console.anthropic.com). Sans clé, la facture s'affiche
# à côté du formulaire pour une saisie manuelle.
ANTHROPIC_API_KEY=
# Dossier des fichiers (par défaut : dossier « factures » à côté de la base, donc sur le volume).
# MONDAIX_DOCUMENTS=
